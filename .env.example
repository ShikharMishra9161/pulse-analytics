# ─── Database ────────────────────────────────────────────────
# Local: `docker compose up -d` provides this database.
# Neon/Supabase: use the *pooled* URL here and the direct URL in DIRECT_URL.
DATABASE_URL="postgresql://pulse:pulse@localhost:5432/pulse?schema=public"
DIRECT_URL="postgresql://pulse:pulse@localhost:5432/pulse?schema=public"

# Used only by `npm test` (integration tests wipe this database).
TEST_DATABASE_URL="postgresql://pulse:pulse@localhost:5432/pulse_test?schema=public"

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Auth.js ─────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Required when running behind a proxy / self-hosting. Vercel sets this automatically.
AUTH_TRUST_HOST=true

# Google OAuth (optional — the Google button is hidden when unset).
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Rate limiting (optional) ────────────────────────────────
# When unset, an in-memory limiter is used (fine for local dev, NOT for multi-instance prod).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Requests per minute per API key on POST /api/v1/events
INGEST_RATE_LIMIT_PER_MINUTE=600
